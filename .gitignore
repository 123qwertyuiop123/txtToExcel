# Python 缓存和测试产物
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# 虚拟环境和本地环境配置
.venv/
venv/
env/
ENV/
.env
.env.*
!.env.example

# IDE、编辑器和操作系统文件
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# PyInstaller / 构建输出
build/
dist/
*.spec

# 本地依赖和前端工具缓存
node_modules/
*.log
npm-debug.log*

# 程序运行产生的临时目录和输出文件
outputs/
tmp/
temp/
*.tmp
*.temp

# Excel 临时锁定文件
~$*.xls*
